# Include from Nginx's http context (for example conf.d). Replace the example
# domains, certificate paths, and VPN CIDR with owner-approved values.
limit_req_zone $binary_remote_addr zone=admind_api:10m rate=10r/m;

# Reject unmatched hosts instead of letting Nginx select the dashboard vhost.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 80;
    server_name dashboard.example.com;
    return 301 https://dashboard.example.com$request_uri;
}

server {
    listen 80;
    server_name api.example.com;
    return 301 https://api.example.com$request_uri;
}

# Keep the Streamlit dashboard and its admin login reachable only from VPN.
server {
    listen 443 ssl http2;
    server_name dashboard.example.com;
    ssl_certificate /etc/letsencrypt/live/dashboard.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dashboard.example.com/privkey.pem;
    client_max_body_size 16k;

    allow 10.8.0.0/24; # Example VPN client subnet; replace before use.
    deny all;

    location / {
        proxy_pass http://127.0.0.1:8501;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }
}

# Public recommendation API only. FastAPI is loopback-bound and accepts
# forwarded client addresses only from that local reverse proxy.
server {
    listen 443 ssl http2;
    server_name api.example.com;
    ssl_certificate /etc/letsencrypt/live/api.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.com/privkey.pem;
    client_max_body_size 16k;

    location /api/ {
        limit_req zone=admind_api burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        return 404;
    }
}
